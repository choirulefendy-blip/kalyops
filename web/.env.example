# Kaly Ops · variabel lingkungan (Vercel: Settings › Environment Variables, pisahkan Preview = staging dan Production)
# URL & anon/publishable key project Supabase (BUKAN service_role)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Rahasia bersama database ↔ /api/push (sama persis dengan app_secrets.push_secret di database itu)
KALY_PUSH_SECRET=
# opsional
VAPID_SUBJECT=mailto:admin@kaly.id
