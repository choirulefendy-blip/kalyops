{
  "name": "kaly-ops-web",
  "version": "2.12.0",
  "private": true,
  "description": "Kaly Ops di Next.js + Vercel: aplikasi Kaly Ops (folder app/) disajikan apa adanya, API (notifikasi push, health) berjalan di Vercel.",
  "scripts": {
    "prepare-static": "node scripts/prepare-static.mjs",
    "dev": "npm run prepare-static && next dev -p 3000",
    "build": "npm run prepare-static && next build",
    "start": "next start -p ${PORT:-3000}"
  },
  "engines": { "node": ">=20.9.0" },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
